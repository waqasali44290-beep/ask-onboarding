# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (local, via Ollama; no API key or cost) ---
# The ollama-pull service downloads this model on first `docker compose up`.
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=512
LLM_CONTEXT_TOKENS=4096

# --- Embeddings (runs locally inside the backend container, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# Chunks scoring below this cosine similarity are ignored; if none remain -> "no answer".
# bge-small scores: answerable questions ~0.65-0.85, unrelated ~0.35-0.6 (see ARCHITECTURE.md)
MIN_SIMILARITY=0.50

# --- Database ---
POSTGRES_USER=ask
POSTGRES_PASSWORD=ask
POSTGRES_DB=ask_onboarding
DATABASE_URL=postgresql+psycopg://ask:ask@db:5432/ask_onboarding

# --- Misc ---
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
