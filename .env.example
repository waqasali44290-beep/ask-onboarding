# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1024

# --- Embeddings (runs locally inside the backend container, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# Chunks scoring below this cosine similarity are ignored; if none remain -> "no answer"
MIN_SIMILARITY=0.35

# --- Database ---
POSTGRES_USER=ask
POSTGRES_PASSWORD=ask
POSTGRES_DB=ask_onboarding
DATABASE_URL=postgresql+psycopg://ask:ask@db:5432/ask_onboarding

# --- Misc ---
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
